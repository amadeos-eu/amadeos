live-boot
live-config
live-config-systemd
systemd-sysv
# Sets the clock from the network once it is connected; the time zone is chosen in the login greeter
systemd-timesyncd
user-setup
sudo
locales
isolinux
syslinux-common
syslinux-utils
xserver-xorg
xserver-xorg-input-all
xserver-xorg-video-all
xserver-xorg-legacy
xinit
# xterm stays for one release next to amade-terminal, the amadeOS terminal; the failsafe session uses it
xterm
# Tab completion for the options of apt, git, systemctl and other commands in bash (amade-terminal
# recommends it, but the image installs no recommends)
bash-completion
dbus
dbus-x11
libpam-systemd
x11-xserver-utils
# Settings > Accessibility: xkbset switches sticky, slow, bounce and mouse keys on and off; dmz-cursor-theme
# has the white and black pointers in 24, 32 and 48 pixels (amadeos-settings keeps X's classic pointer as the
# default cursor theme). Both are dependencies of amadeos-settings, listed here because the image is built with
# them in mind.
xkbset
dmz-cursor-theme
# The user's folders in the session's language (~/Dokumente, ~/Downloads ...), created at login by
# /etc/amadeos/autostart.d/05-xdg-user-dirs of amadeos-session.
xdg-user-dirs
xauth
x11-utils
xdg-utils
desktop-file-utils
shared-mime-info
file
libxss1
openjdk-25-jre
fontconfig
fonts-dejavu-core
# Black and white emoji for the Smileys and Emoji window of the amade programs (Java2D cannot draw
# the colour emoji font)
fonts-symbola
# Free fonts with the measures of the common office fonts, so that Word, Excel and PowerPoint files keep their
# line and page breaks: Liberation for Times New Roman, Arial and Courier New, Carlito for Calibri, Caladea for
# Cambria; Noto for the scripts of Europe and beyond (about 45 MB). LibreOffice brings none of them without
# recommends. The Font Viewer (amade-fontviewer) shows them all.
fonts-liberation
fonts-crosextra-carlito
fonts-crosextra-caladea
fonts-noto-core
ca-certificates
# Sound: PipeWire with PulseAudio and ALSA compatibility (Java Sound plays through ALSA),
# wpctl (WirePlumber) and pactl for volume and output selection in amade-audio
pipewire
pipewire-pulse
pipewire-alsa
wireplumber
pulseaudio-utils
alsa-utils
# amade-audio: audio CDs (libcdio, error correction with libcdio-paranoia), General MIDI
# SoundFont, tracker modules (libopenmpt: MOD, XM, S3M, IT), eject; recommended by the package
# but the image installs no recommends
libcdio19t64
libcdio-cdda2t64
libcdio-paranoia2t64
fluid-soundfont-gm
libopenmpt0t64
eject
# Network: NetworkManager (Ethernet via DHCP, WLAN via wpasupplicant, nmcli/nmtui), driven by the
# network cell of the front panel; polkitd lets the netdev group manage connections without root
network-manager
wpasupplicant
wireless-regdb
polkitd
# USB sticks, memory cards and discs in the File Manager (amade-files): udisksctl mounts them below
# /media/USER for the user at the screen and switches USB disks off for Safely Remove
udisks2
# Disks (amadeos-disks) formats through udisks: exFAT and NTFS need their mkfs tools, cryptsetup makes
# password-protected sticks (LUKS); FAT and ext4 come from dosfstools and e2fsprogs (below)
exfatprogs
ntfs-3g
cryptsetup
# Network drives in the File Manager (amade-files): gvfs connects SMB shares of NAS boxes and PCs, NFS,
# WebDAV, FTP and SFTP as the user (gio mount), gvfs-fuse shows them as folders below /run/user/UID/gvfs;
# avahi (below) finds servers by mDNS. wsdd (WS-Discovery, for Windows PCs) is not in Debian trixie, so
# servers that only announce themselves that way are connected with File > Connect to Server
gvfs
gvfs-backends
gvfs-fuse
# gio, the command the File Manager connects and lists network drives with (gvfs does not pull it in)
libglib2.0-bin
# notify-send, for scripts that show a notification (Settings > Notifications)
libnotify-bin
# Firmware for the common WLAN and Ethernet chips (live-build's --firmware-chroot would add all of it)
firmware-iwlwifi
firmware-realtek
firmware-atheros
firmware-brcm80211
firmware-mediatek
# Web browser: Firefox ESR (Gecko, MPL-2.0) with the five desktop languages; preconfigured
# by /usr/share/firefox-esr/distribution/policies.json (no telemetry, Ecosia, uBlock Origin)
firefox-esr
firefox-esr-l10n-de
firefox-esr-l10n-fr
firefox-esr-l10n-es-es
firefox-esr-l10n-it
# Office: LibreOffice (MPL-2.0) with the five desktop languages: Writer, Calc, Impress, Draw and
# Math, all in the Text & Office drawer (Draw also in Graphics). Writer is the full word processor
# for what amade-writepad does not do, and amade-writepad's converter for the old binary Word
# format: it opens .doc files through soffice --headless --convert-to docx and saves .doc the same
# way. Base is left out: it needs a Java database engine and has no counterpart in the desktop yet.
# Without recommends LibreOffice draws with its own X11 toolkit, no GTK or Qt.
libreoffice-writer
libreoffice-calc
libreoffice-impress
libreoffice-draw
libreoffice-math
libreoffice-l10n-de
libreoffice-l10n-fr
libreoffice-l10n-es
libreoffice-l10n-it
# EPUBCheck for amade-bookeditor's Check Book, which checks books against the EPUB standard with it;
# recommended by the package but the image installs no recommends
epubcheck
# Hyphenation patterns of the five desktop languages for amade-books (and the Book Editor's preview), which justifies and hyphenates
# the text of e-books itself; recommended by the package but the image installs no recommends
hyphen-en-us
hyphen-de
hyphen-fr
hyphen-it
hyphen-es
# jpegtran for amade-imageviewer and amade-imageeditor, which save turned JPEGs without loss; recommended by the package
# but the image installs no recommends
libjpeg-turbo-progs
# cwebp for amade-imageeditor, which saves WebP pictures with it; recommended by the package but the
# image installs no recommends
webp
# yt-dlp for amade-video and amade-tv: mpv plays internet videos and the YouTube streams of a few
# TV channels through it; recommended by both packages, but the image installs no recommends
yt-dlp
# v4l2-ctl for amade-webcam, which lists the sizes of a camera and sets its picture controls with it;
# a dependency of the package, listed here because the image is built with it in mind
v4l-utils
# Calls (amade-call): GStreamer's WebRTC parts (webrtcbin in plugins-bad, libnice for the connection), VP8 and
# the camera (plugins-good), Opus (plugins-base) and PulseAudio/PipeWire for microphone and speakers;
# avahi-utils announces the program and finds the others in the network. Dependencies of the package,
# listed here because the image is built with it in mind
gstreamer1.0-plugins-base
gstreamer1.0-plugins-good
gstreamer1.0-plugins-bad
gstreamer1.0-nice
gstreamer1.0-pulseaudio
avahi-utils
# Bluetooth: BlueZ (bluetoothd), which Settings > Bluetooth and the Bluetooth cell of the front panel
# drive over D-Bus; libspa-0.2-bluetooth lets PipeWire play on Bluetooth headphones and speakers.
# The live user is in the bluetooth group (/etc/live/config.conf), so pairing needs no password.
bluez
libspa-0.2-bluetooth
# Printing: CUPS with driverless printing (IPP Everywhere, AirPrint). avahi finds network printers,
# cups-browsed sets them up as queues, ipp-usb serves USB printers over IPP. amadeos-print manages them;
# the live user is in lpadmin (/etc/live/config.conf), so no password is needed for that.
cups
cups-client
cups-filters
cups-browsed
ipp-usb
avahi-daemon
libnss-mdns
# Ghostscript: ps2pdf, with which amade-labelprinter saves labels as PDF (a recommends, so named here)
ghostscript
# Scanning (amade-imagescan through SANE): sane-airscan finds network scanners and the scanners of
# all-in-one printers (eSCL/AirScan, WSD) without vendor drivers, also over USB through ipp-usb above
sane-airscan
# Passwords: gnome-keyring as the Secret Service of the session (no GNOME desktop, no keyring GUI),
# unlocked at login by pam_gnome_keyring in /etc/pam.d/amadeos-dm; amade-mail and amade-audio store
# their passwords there through secret-tool. dbus-user-session gives the session the user bus that
# the keyring daemon and secret-tool meet on.
dbus-user-session
gnome-keyring
libpam-gnome-keyring
libsecret-tools
# amadeos-sysinfo names the graphics adapter with lspci
pciutils
grub-efi-amd64-bin
# Installation to disk (amadeos-installer, own repository): the system is copied with unsquashfs,
# partitions and file systems come from util-linux, dosfstools and e2fsprogs, GRUB for BIOS and UEFI
# from grub-pc-bin and grub-efi-amd64-bin (the meta packages grub-pc and grub-efi-amd64 conflict with
# each other, so the packages hook keeps their .deb files for the installer), the signed shim and GRUB
# let an installed system boot with Secure Boot, pkexec runs amadeos-install as root from the wizard,
# os-prober gives Windows and other systems on the computer their GRUB entries.
squashfs-tools
dosfstools
e2fsprogs
grub2-common
grub-pc-bin
grub-efi-amd64-signed
shim-signed
efibootmgr
pkexec
os-prober
