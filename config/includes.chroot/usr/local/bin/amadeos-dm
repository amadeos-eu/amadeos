#!/bin/sh
set -e

echo "[amadeos-dm] Initializing amadeOS Display Manager on vt7..."

# Start Xorg server on vt7 if not already active
if [ ! -e "/tmp/.X11-unix/X0" ]; then
    echo "[amadeos-dm] Starting Xorg display server on vt7..."
    Xorg :0 vt7 -nolisten tcp -background none >/var/log/amadeos-xorg.log 2>&1 &
    XORG_PID=$!

    # Wait for Xorg to be ready and accept connections
    READY=0
    for i in $(seq 1 60); do
        if [ -e "/tmp/.X11-unix/X0" ]; then
            if command -v xset >/dev/null 2>&1; then
                if xset -q -display :0 >/dev/null 2>&1; then
                    echo "[amadeos-dm] Xorg is ready and responding on :0 (iteration $i)"
                    READY=1
                    break
                fi
            else
                READY=1
                break
            fi
        fi
        sleep 0.1
    done

    if [ "$READY" -eq 0 ]; then
        echo "[amadeos-dm] Warning: Xorg socket wait timed out, proceeding..."
    fi

    # Switch console to VT7 so user sees the graphical display
    if command -v chvt >/dev/null 2>&1; then
        chvt 7 2>/dev/null || true
    fi
fi

export DISPLAY=:0

# Authorize local users to connect to the X server (prevents "No protocol specified" when user session launches)
if command -v xhost >/dev/null 2>&1; then
    echo "[amadeos-dm] Authorizing local users on X server..."
    xhost +local: 2>/dev/null || xhost + 2>/dev/null || true
fi

if [ -f /etc/default/locale ]; then
    . /etc/default/locale
fi
export LANG="${LANG:-de_DE.UTF-8}"
export LC_ALL="${LC_ALL:-de_DE.UTF-8}"

# Ensure amadeos user password is set to 'amadeos' in /etc/shadow and home directory permissions are clean
if id amadeos >/dev/null 2>&1; then
    echo 'amadeos:$6$1xsQWb3aVS24Y0d3$LXLQITUwA2aUMUnBPnD1k8MQV/UHSLTg4aQMHQk0H2EkcJFpn6ScFHQhsLDOeJ6J2zVgwxWjoeKNLT2WJ8ObJ1' | chpasswd -e 2>/dev/null || true
    if [ -d /home/amadeos ]; then
        chown -R amadeos:amadeos /home/amadeos 2>/dev/null || true
        rm -f /home/amadeos/.amadeos-session.log /home/amadeos/.amadeos-wm.log /home/amadeos/.amadeos-panel.lock /home/amadeos/.amadeos-wm.pid 2>/dev/null || true
    fi
fi

# Configure keyboard layout (German primary with US fallback)
if command -v setxkbmap >/dev/null 2>&1; then
    echo "[amadeos-dm] Applying keyboard layout (de,us)..."
    setxkbmap -layout "de,us" -option "grp:alt_shift_toggle" 2>/dev/null || setxkbmap "de" 2>/dev/null || true
fi

JAVA_BIN="/usr/lib/jvm/java-21-openjdk-amd64/bin/java"
if [ ! -x "$JAVA_BIN" ]; then
    JAVA_BIN="$(command -v java || true)"
fi

JAR_BIN="/opt/amadeos/amadeos.jar"
if [ ! -f "$JAR_BIN" ]; then
    JAR_BIN="/opt/amadeos/amadeos-demo.jar"
fi

echo "[amadeos-dm] Launching Java Display Manager daemon..."
exec "$JAVA_BIN" --enable-native-access=ALL-UNNAMED -jar "$JAR_BIN" dm :0


