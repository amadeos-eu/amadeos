#!/bin/sh
# Runs inside the chroot. Debian's live-build reads config/hooks/normal/*.chroot; for Ubuntu's live-build
# 3.0, which reads config/hooks/*.chroot, scripts/build-image.sh links the hooks there. Permissions of the
# files from config/includes.chroot, which live-build does not keep, and the X server settings of the live
# image. The quick repack mode of scripts/build-image.sh runs this script again after copying the includes
# into the chroot. The desktop's own scripts, unit, PAM and polkit files come with the desktop packages
# (amadeos-dm, amadeos-session, amadeos-wm, amadeos-panel-cde, amadeos-settings); amadeos-dm's postinst enables amadeos-dm.service.
set -eu

chmod 0755 /usr/local/bin/amadeos-live-user
if [ -f /usr/local/bin/rsvg ]; then
    chmod 0755 /usr/local/bin/rsvg
fi
chmod 0644 /etc/systemd/system/amadeos-dm.service.d/live.conf

mkdir -p /etc/X11
# Only the user on the active console may start Xorg via the setuid wrapper (startx on tty1).
cat > /etc/X11/Xwrapper.config << 'EOT'
allowed_users=console
needs_root_rights=yes
EOT
chmod 0644 /etc/X11/Xwrapper.config
