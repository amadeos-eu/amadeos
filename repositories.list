# The repositories of the amadeOS distribution. buildDistribution.sh clones the missing ones next to
# this repository (https://github.com/amadeos-eu/<name>) and builds every one with an installToAmadeOs
# task into the image. A new application or game is added here, and is then installed by default; the
# meta package amadeos-desktop (scripts/package-desktop-meta.sh) recommends it under the repository's name,
# so installed systems get it with their next update.
#
# "# optional" after a name keeps that program out of the image and out of amadeos-desktop: it is released
# and published on apt.amadeos.eu like every other one, and installed from Software or with
# "sudo apt install <name>". The meta package amadeos-games recommends every game, optional or not.
# scripts/list-repositories.sh --image / --optional reads the two lists.

# Libraries (built through the composite builds of the packages that use them)
amade-commons
amade-game-engine

# System components and the installer
amadeos-installer
amadeos-system

# Applications
amade-audio
amade-backup
amade-books
amade-bookeditor
amade-calculator
amade-calendar
amade-call
amade-contacts
amade-familytree
amade-files
amade-fractals
amade-imageeditor
amade-imagescan
amade-imageviewer
amade-labelprinter
amade-fontviewer
amade-mail
amade-news
amade-pad
amade-pdfviewer
amade-screenshot
amade-terminal
amade-tv
amade-video
amade-web
amade-webcam
amade-writepad

# Content
amadeos-sample-books

# Games in the image (Games drawer of the Front Panel)
amade-mines-game
amade-solitaire-game

# Optional games (only on apt.amadeos.eu: Software, or amadeos-games for all)
amade-artillery-game    # optional
amade-blast-game        # optional
amade-bricks-game       # optional
amade-colony-game       # optional
amade-cruise-game       # optional
amade-hover-cab-game    # optional
amade-jump-game         # optional
amade-maze-game         # optional
amade-paddle-game       # optional
amade-pinball-game      # optional
amade-rivet-game        # optional
amade-rocks-game        # optional
amade-sands-game        # optional
amade-snake-game        # optional
amade-swarm-game        # optional
amade-templar-game      # optional
amade-towers-game       # optional
amade-town-game         # optional
