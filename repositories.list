# The repositories of the amadeOS distribution. buildDistribution.sh clones the missing ones next to
# this repository (https://github.com/datazuul/<name>) and builds every one with an installToAmadeOs
# task into the image. A new application or game is added here, and is then installed by default.

# Libraries (built through the composite builds of the packages that use them)
amade-commons
amade-game-engine

# System components and the installer
amadeos-installer
amadeos-system

# Applications
amade-audio
amade-calculator
amade-calendar
amade-files
amade-fractals
amade-imagescan
amade-imageviewer
amade-mail
amade-pad
amade-screenshot
amade-video
amade-web
amade-writepad

# Games (Games drawer of the Front Panel)
amade-blast-game
amade-bricks-game
amade-colony-game
amade-hover-cab-game
amade-jump-game
amade-maze-game
amade-mines-game
amade-paddle-game
amade-rocks-game
amade-sands-game
amade-snake-game
amade-solitaire-game
amade-swarm-game
amade-towers-game
amade-town-game
