#!/bin/sh
set -eu

export DEBIAN_FRONTEND=noninteractive

apt-get update
# Pull fixes from trixie-security/trixie-updates (config/archives) into the base system too.
apt-get dist-upgrade --yes --no-install-recommends
apt-get install --yes --no-install-recommends \
    live-boot \
    live-config \
    live-config-systemd \
    systemd-sysv \
    user-setup \
    sudo \
    locales \
    isolinux \
    syslinux-common \
    syslinux-utils \
    xserver-xorg \
    xserver-xorg-input-all \
    xserver-xorg-video-all \
    xserver-xorg-legacy \
    xinit \
    xterm \
    dbus \
    dbus-x11 \
    libpam-systemd \
    x11-xserver-utils \
    xauth \
    openjdk-21-jre \
    fontconfig \
    fonts-dejavu-core \
    ca-certificates \
    grub-efi-amd64-bin \
    pipewire \
    pipewire-pulse \
    pipewire-alsa \
    wireplumber \
    pulseaudio-utils \
    alsa-utils \
    libcdio19t64 \
    libcdio-cdda2t64 \
    libcdio-paranoia2t64 \
    fluid-soundfont-gm \
    eject \
    network-manager \
    wpasupplicant \
    wireless-regdb \
    polkitd \
    firmware-iwlwifi \
    firmware-realtek \
    firmware-atheros \
    firmware-brcm80211 \
    firmware-mediatek

# Configure locales
if [ -f /etc/locale.gen ]; then
    echo "de_DE.UTF-8 UTF-8" >> /etc/locale.gen
    echo "en_US.UTF-8 UTF-8" >> /etc/locale.gen
    # The other languages of the desktop, selectable at login and in the front panel
    echo "fr_FR.UTF-8 UTF-8" >> /etc/locale.gen
    echo "es_ES.UTF-8 UTF-8" >> /etc/locale.gen
    echo "it_IT.UTF-8 UTF-8" >> /etc/locale.gen
    locale-gen || true
fi

# Ensure syslinux/isolinux binaries and modules are available for bootloader creation
mkdir -p /usr/lib/syslinux
if [ -f /usr/lib/ISOLINUX/isolinux.bin ]; then
    ln -sf /usr/lib/ISOLINUX/isolinux.bin /usr/lib/syslinux/isolinux.bin
fi
if [ -d /usr/lib/syslinux/modules/bios ]; then
    for f in /usr/lib/syslinux/modules/bios/*; do
        if [ -f "$f" ]; then
            ln -sf "$f" "/usr/lib/syslinux/$(basename "$f")"
        fi
    done
fi

apt-get clean
rm -rf /var/lib/apt/lists/*

