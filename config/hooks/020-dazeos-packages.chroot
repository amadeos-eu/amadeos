#!/bin/sh
set -eu

export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install --yes --no-install-recommends \
    live-boot \
    live-config \
    live-config-systemd \
    systemd-sysv \
    isolinux \
    syslinux-common \
    syslinux-utils \
    xserver-xorg \
    xserver-xorg-input-all \
    xserver-xorg-video-all \
    xinit \
    dbus-x11 \
    x11-xserver-utils \
    openjdk-21-jre \
    fontconfig \
    fonts-dejavu-core \
    ca-certificates

# Ensure syslinux/isolinux binaries and modules are available for bootloader creation
mkdir -p /usr/lib/syslinux
if [ -f /usr/lib/ISOLINUX/isolinux.bin ]; then
    ln -sf /usr/lib/ISOLINUX/isolinux.bin /usr/lib/syslinux/isolinux.bin
fi
if [ -d /usr/lib/syslinux/modules/bios ]; then
    for f in /usr/lib/syslinux/modules/bios/*; do
        if [ -f "$f" ]; then
            ln -sf "$f" "/usr/lib/syslinux/$(basename "$f")"
        fi
    done
fi

apt-get clean
rm -rf /var/lib/apt/lists/*

