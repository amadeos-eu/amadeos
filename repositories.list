# The repositories of the amadeOS distribution. buildDistribution.sh clones the missing ones next to
# this repository (https://github.com/amadeos-eu/<name>) and builds every one with an installToAmadeOs
# task into the image. A new application or game is added here, and is then installed by default.

# Libraries (built through the composite builds of the packages that use them)
amade-commons
amade-game-engine

# System components and the installer
amadeos-installer
amadeos-system

# Applications
amade-audio
amade-backup
amade-books
amade-calculator
amade-calendar
amade-contacts
amade-files
amade-fractals
amade-imageeditor
amade-imagescan
amade-imageviewer
amade-mail
amade-news
amade-pad
amade-pdfviewer
amade-screenshot
amade-tv
amade-video
amade-web
amade-webcam
amade-writepad

# Content
amadeos-sample-books

# Games (Games drawer of the Front Panel)
amade-artillery-game
amade-blast-game
amade-bricks-game
amade-colony-game
amade-hover-cab-game
amade-jump-game
amade-maze-game
amade-mines-game
amade-paddle-game
amade-rivet-game
amade-rocks-game
amade-sands-game
amade-snake-game
amade-solitaire-game
amade-swarm-game
amade-templar-game
amade-towers-game
amade-town-game
