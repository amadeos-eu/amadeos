#!/bin/sh
set -eu

export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install --yes --no-install-recommends \
    live-boot \
    live-config \
    systemd-sysv \
    xserver-xorg \
    xserver-xorg-input-all \
    xserver-xorg-video-all \
    xinit \
    dbus-x11 \
    x11-xserver-utils \
    openjdk-21-jre \
    fontconfig \
    fonts-dejavu \
    ca-certificates

apt-get clean
rm -rf /var/lib/apt/lists/*

