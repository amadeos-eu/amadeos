#!/bin/sh
set -eu

chmod 0755 /usr/local/bin/dazeos-session
if [ -f /usr/local/bin/rsvg ]; then
    chmod 0755 /usr/local/bin/rsvg
fi
chmod 0755 /etc/skel/.xinitrc
mkdir -p /opt/dazeos
if [ -f /opt/dazeos/dazeos-demo.jar ]; then
    chmod 0644 /opt/dazeos/dazeos-demo.jar
fi
mkdir -p /etc/X11
cat > /etc/X11/Xwrapper.config << 'EOF'
allowed_users=anybody
needs_root_rights=yes
EOF
chmod 0644 /etc/X11/Xwrapper.config

if [ -f /etc/systemd/system/dazeos-dm.service ]; then
    chmod 0644 /etc/systemd/system/dazeos-dm.service
    systemctl enable dazeos-dm.service 2>/dev/null || true
    systemctl set-default graphical.target 2>/dev/null || true
fi
if [ -f /etc/pam.d/dazeos-dm ]; then
    chmod 0644 /etc/pam.d/dazeos-dm
fi


