NAME="sda" PATH="/dev/sda" SIZE="256060514304" MODEL="Demo SSD 256GB" TYPE="disk" RM="0" RO="0" MOUNTPOINTS="" PKNAME="" FSTYPE="" TRAN="sata" PARTTYPE="" LABEL=""
END
