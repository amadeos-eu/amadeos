#!/bin/sh
# Runs inside the chroot after live-build installed config/package-lists/amadeos.list.chroot
# (the only list of packages) and the .deb files of config/packages.chroot. See 010-amadeos-permissions.chroot
# for live-build 3.0.
set -eu

export DEBIAN_FRONTEND=noninteractive

# Pull fixes from trixie-security/trixie-updates (config/archives) into the base system too. The amadeOS
# repository (amadeos-archive-keyring) stays out of this: it would replace the amade packages built for this
# image (a develop build is X.Y.Z~dev.0) with the released ones. Installed systems use it.
amadeos_sources=/etc/apt/sources.list.d/amadeos.sources
[ ! -f "$amadeos_sources" ] || mv "$amadeos_sources" "$amadeos_sources.build"
apt-get update
apt-get dist-upgrade --yes --no-install-recommends
[ ! -f "$amadeos_sources.build" ] || mv "$amadeos_sources.build" "$amadeos_sources"

# wsdd is there for gvfs, which starts it itself to find Windows PCs and NAS boxes (network:/// in the File
# Manager). Its own service would announce this computer as a Windows server; amadeOS shares nothing.
if [ -f /lib/systemd/system/wsdd.service ] || [ -f /usr/lib/systemd/system/wsdd.service ]; then
    systemctl disable wsdd.service || true
fi

# The locales of the five desktop languages, selectable at login and in the front panel.
if [ -f /etc/locale.gen ]; then
    for locale in de_DE en_US fr_FR es_ES it_IT; do
        grep -q "^$locale.UTF-8 UTF-8" /etc/locale.gen || echo "$locale.UTF-8 UTF-8" >> /etc/locale.gen
    done
    locale-gen || true
fi

# Ensure syslinux/isolinux binaries and modules are available for bootloader creation
mkdir -p /usr/lib/syslinux
if [ -f /usr/lib/ISOLINUX/isolinux.bin ]; then
    ln -sf /usr/lib/ISOLINUX/isolinux.bin /usr/lib/syslinux/isolinux.bin
fi
if [ -d /usr/lib/syslinux/modules/bios ]; then
    for f in /usr/lib/syslinux/modules/bios/*; do
        if [ -f "$f" ]; then
            ln -sf "$f" "/usr/lib/syslinux/$(basename "$f")"
        fi
    done
fi

# The installer (package amadeos-installer) gives the installed system GRUB's meta package for its
# firmware, grub-pc or grub-efi-amd64, so that later GRUB upgrades reinstall the boot loader. The two
# conflict with each other, so the image cannot hold them installed; their .deb files are kept for the
# installer instead (amadeos-install reads /var/lib/amadeos-installer and removes it from the target).
if dpkg -s amadeos-installer >/dev/null 2>&1; then
    mkdir -p /var/lib/amadeos-installer
    (cd /var/lib/amadeos-installer && apt-get download grub-pc grub-efi-amd64) \
        || echo "Warning: grub-pc and grub-efi-amd64 could not be downloaded; installed systems need grub-install by hand after GRUB upgrades" >&2
fi

apt-get clean
rm -rf /var/lib/apt/lists/*
